[Unit]
Description=career-platform website (FastAPI on uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=career-app
Group=career-app
WorkingDirectory=/opt/career-platform
EnvironmentFile=/etc/career-platform/app.env
ExecStart=/opt/career-platform/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
